# Supabase (Project Settings → API). Usar la clave SECRETA: solo vive en el backend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Ollama local
OLLAMA_MODEL=llama3.2:latest
